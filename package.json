{
  "name": "decky-youtube-pip",
  "version": "0.3.1",
  "description": "YouTube picture-in-picture for Decky Loader",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "package": "sh scripts/package.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shdwsl/decky-youtube-pip.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "youtube",
    "pip"
  ],
  "author": "shdwsl",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/shdwsl/decky-youtube-pip/issues"
  },
  "homepage": "https://github.com/shdwsl/decky-youtube-pip#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.16.5",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.22.5",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "cotton-box": "^0.3.0",
    "cotton-box-react": "^0.3.0",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
